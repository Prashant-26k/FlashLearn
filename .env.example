# Application settings
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=

# Authentication
JWT_SECRET=

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=

# Render deployment (optional)
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Server-side AI credentials. Never prefix these with VITE_.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openrouter/free
AI_PROVIDER_ORDER=gemini,groq,openrouter

# AI safety limits
FREE_DAILY_GENERATION_LIMIT=10
GLOBAL_DAILY_GENERATION_LIMIT=1000
GLOBAL_DAILY_AI_REQUEST_LIMIT=3000
MAX_FLASHCARDS_PER_GENERATION=50
MAX_DOCUMENT_SIZE_MB=10
MAX_CHUNKS_PER_GENERATION=20
MAX_CONCURRENT_AI_REQUESTS=3
AI_RETRY_ATTEMPTS=2
AI_REQUEST_TIMEOUT_MS=30000
AI_TELEMETRY_RETENTION_DAYS=30
